{
  "schema": "ellmos.module.v2",
  "id": "system-explorer",
  "display_name": "System Explorer",
  "version": "0.1.0",
  "category": "control",
  "kind": "tool",
  "status": "development",
  "visibility": "private",
  "description": "Evidence-backed maps of desired functions, carriers, actual use, and architecture drift.",
  "package": "system_explorer",
  "entrypoints": {
    "cli": "system-explorer --help",
    "ui": "system-explorer serve --config <path>"
  },
  "provides": [
    "system.discovery",
    "system.mapping",
    "system.coverage",
    "system.architecture.diff",
    "system.control-document.mapping",
    "system.directory-tree",
    "system.data-topology",
    "system.cloud-topology",
    "system.deployment-purpose-analysis",
    "system.server-privacy-check",
    "system.cost-local-comparison",
    "system.map.export",
    "system.map.import",
    "system.map.federation",
    "system.fleet.resolve",
    "system.host-deviation.analysis",
    "system.llm-trace-analysis",
    "system.llm-action-surface",
    "system.software-resource.mapping",
    "system.llm-readiness-analysis",
    "system.crystallized-intelligence.mapping",
    "system.token-saving-endpoint.analysis",
    "api-prober.evidence-adapter",
    "registry.discovery",
    "database.schema.mapping",
    "evidence.registry",
    "document.registry",
    "change.proposal.readonly",
    "trampelpfad.probe-plan"
  ],
  "requires": [],
  "optional": [
    "controlcenter.context",
    "policy.registry",
    "byum.prompt-evidence",
    "hooker.runtime-evidence",
    "swarm-ai.probe-runner",
    "unified-gui.host",
    "system-gap-master.handoff",
    "apiprober.passive-export"
  ],
  "conflicts": [
    "target-system.mutation",
    "second-control-plane"
  ],
  "surfaces": [
    "library",
    "cli",
    "ui"
  ],
  "state": {
    "ownership": "module",
    "location": "user-home"
  },
  "boundaries": {
    "network": "local",
    "data": "user-local",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/ellmos-ai/system-explorer"
  },
  "adapters": [
    {"type": "cli-wrapper", "id": "codex-jsonl"},
    {"type": "cli-wrapper", "id": "claude-code-jsonl"},
    {"type": "cli-wrapper", "id": "claude-desktop-audit-jsonl"},
    {"type": "cli-wrapper", "id": "gemini-sqlite"},
    {"type": "cli-wrapper", "id": "kimi-wire-jsonl"},
    {"type": "cli-wrapper", "id": "generic-jsonl"}
  ]
}
