{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.ai/schemas/system-explorer.ai-media-editor-handoff.v1.schema.json",
  "title": "System Explorer ai-media-editor Handoff",
  "type": "object",
  "required": [
    "schema",
    "producer",
    "consumer",
    "production",
    "truth_boundary"
  ],
  "properties": {
    "schema": {
      "const": "system-explorer.ai-media-editor-handoff.v1"
    },
    "producer": {
      "type": "object",
      "required": ["id", "source_map_hash", "views"],
      "properties": {
        "id": {"const": "system-explorer"},
        "source_map_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "consumer": {
      "type": "object",
      "required": ["id", "version", "root", "workflow"],
      "properties": {
        "id": {"const": "ai-media-editor"},
        "version": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "required": [
        "usecase",
        "kind",
        "aspect_ratio",
        "rendered",
        "strategy_confirmation_required_before_render",
        "artifacts"
      ],
      "properties": {
        "usecase": {"const": 6},
        "kind": {"const": "explainer-video"},
        "aspect_ratio": {"enum": ["16:9", "9:16", "1:1"]},
        "rendered": {"const": false},
        "strategy_confirmation_required_before_render": {"const": true},
        "artifacts": {
          "type": "object",
          "required": ["narration", "storyboard", "maps"],
          "properties": {
            "narration": {"type": "string", "minLength": 1},
            "storyboard": {"type": "string", "minLength": 1},
            "maps": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "truth_boundary": {
      "type": "object",
      "required": [
        "map_names_only",
        "raw_evidence_copied",
        "render_requires_ai_media_editor_workflow"
      ],
      "properties": {
        "map_names_only": {"const": true},
        "raw_evidence_copied": {"const": false},
        "render_requires_ai_media_editor_workflow": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
