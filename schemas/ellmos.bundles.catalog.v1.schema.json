{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.ai/schemas/ellmos.bundles.catalog.v1.schema.json",
  "title": "ellmos bundle catalog contract",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "lifecycle",
    "authority",
    "provenance",
    "content_hash",
    "bundles"
  ],
  "properties": {
    "schema": {"const": "ellmos.bundles.catalog.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "lifecycle": {"enum": ["draft", "active", "deprecated"]},
    "authority": {"type": "object"},
    "provenance": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "manifest", "visibility", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "manifest": {"type": "string", "minLength": 1},
          "visibility": {"enum": ["public", "private", "commercial"]},
          "status": {"$ref": "#/$defs/status"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "status": {
      "enum": [
        "registered",
        "available",
        "installed",
        "configured",
        "enabled",
        "active",
        "healthy",
        "suppressed",
        "experimental",
        "unavailable"
      ]
    }
  }
}
