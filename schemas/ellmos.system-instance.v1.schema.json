{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.ai/schemas/ellmos.system-instance.v1.schema.json",
  "title": "ellmos desired system instance contract",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "lifecycle",
    "authority",
    "provenance",
    "content_hash",
    "instance_id",
    "system_ref",
    "host_id",
    "desired_profile",
    "component_states",
    "desired_sources",
    "evidence_refs",
    "output_bindings"
  ],
  "properties": {
    "schema": {"const": "ellmos.system-instance.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "lifecycle": {"enum": ["draft", "active", "deprecated"]},
    "authority": {"type": "object"},
    "provenance": {"type": "object"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "instance_id": {"type": "string", "minLength": 1},
    "system_ref": {"$ref": "#/$defs/pinned_ref"},
    "host_id": {"type": "string", "minLength": 1},
    "desired_profile": {"type": "string", "minLength": 1},
    "component_states": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/component_state"}
    },
    "desired_sources": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "output_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/output_binding"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "registered",
        "available",
        "installed",
        "configured",
        "enabled",
        "active",
        "healthy",
        "suppressed",
        "experimental",
        "unavailable"
      ]
    },
    "component_state": {
      "type": "object",
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "desired_profile": {"type": "string", "minLength": 1},
        "publisher_slot": {"type": "string", "minLength": 1},
        "publishes": {"const": "signed-path-metadata-only"},
        "peer_transfer": {"const": "sftp-over-ssh"},
        "network_path": {"const": "direct-or-tailscale"},
        "peer_verification": {"const": "signed-registry-and-pinned-host-key"},
        "destination_policy": {"const": "normalized-allowlisted-no-overwrite"},
        "activation": {
          "enum": ["blocked", "ready-disabled", "shadow-pilot", "reviewed-activation"]
        },
        "database_allowlist": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "live_database_in_sync": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "anyOf": [
                  {"required": ["publisher_slot"]},
                  {"required": ["publishes"]},
                  {"required": ["peer_transfer"]},
                  {"required": ["network_path"]},
                  {"required": ["peer_verification"]},
                  {"required": ["destination_policy"]}
                ]
              }
            },
            {
              "required": [
                "publisher_slot",
                "publishes",
                "peer_transfer",
                "network_path",
                "peer_verification",
                "destination_policy"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "not": {
                "anyOf": [
                  {"required": ["activation"]},
                  {"required": ["database_allowlist"]},
                  {"required": ["live_database_in_sync"]}
                ]
              }
            },
            {"required": ["activation", "database_allowlist", "live_database_in_sync"]}
          ]
        },
        {
          "if": {
            "properties": {"activation": {"const": "ready-disabled"}},
            "required": ["activation"]
          },
          "then": {
            "properties": {"live_database_in_sync": {"const": false}},
            "required": ["live_database_in_sync"]
          }
        }
      ]
    },
    "ref": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "anyOf": [
            {"required": ["ref"]},
            {"required": ["id"]},
            {"required": ["path"]}
          ],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "minLength": 1},
            "content_hash": {"$ref": "#/$defs/hash"}
          },
          "additionalProperties": true
        }
      ]
    },
    "pinned_ref": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {
          "type": "object",
          "anyOf": [
            {"required": ["version"]},
            {"required": ["commit"]},
            {"required": ["content_hash"]}
          ]
        }
      ]
    },
    "output_binding": {
      "type": "object",
      "required": [
        "kind",
        "owner_ref",
        "storage_uri",
        "visibility",
        "raw_content_allowed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "one_off_report",
            "decision_request",
            "decision_synthesis",
            "automation_summary",
            "runtime_log",
            "audit_receipt"
          ]
        },
        "owner_ref": {"type": "string", "minLength": 1},
        "storage_uri": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "private", "commercial"]},
        "retention": {"type": "string", "minLength": 1},
        "backup_uri": {"type": "string", "minLength": 1},
        "desktop_shortcut": {"type": "string", "minLength": 1},
        "materialization": {"enum": ["resolution-only-unmaterialized"]},
        "raw_content_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
