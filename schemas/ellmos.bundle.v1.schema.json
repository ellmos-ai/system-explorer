{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.ai/schemas/ellmos.bundle.v1.schema.json",
  "title": "ellmos bundle contract",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "lifecycle",
    "authority",
    "provenance",
    "content_hash",
    "display_name",
    "purpose",
    "visibility",
    "assurance_contract",
    "components",
    "profiles"
  ],
  "properties": {
    "schema": {"const": "ellmos.bundle.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "authority": {"type": "object"},
    "provenance": {"type": "object"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "display_name": {"type": "string", "minLength": 1},
    "purpose": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "visibility": {"enum": ["public", "private", "commercial"]},
    "assurance_contract": {"$ref": "#/$defs/ref"},
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "registered",
        "available",
        "installed",
        "configured",
        "enabled",
        "active",
        "healthy",
        "suppressed",
        "experimental",
        "unavailable"
      ]
    },
    "lifecycle": {"enum": ["draft", "active", "deprecated"]},
    "ref": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "anyOf": [
            {"required": ["ref"]},
            {"required": ["id"]},
            {"required": ["path"]}
          ],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "minLength": 1},
            "content_hash": {"$ref": "#/$defs/hash"}
          },
          "additionalProperties": true
        }
      ]
    },
    "component": {
      "type": "object",
      "required": [
        "type",
        "ref",
        "role",
        "requirement",
        "provides",
        "consumes"
      ],
      "properties": {
        "type": {
          "enum": [
            "module",
            "skill",
            "software_app",
            "interface",
            "data_endpoint",
            "access_surface",
            "policy_document",
            "decision_record",
            "prompt_asset",
            "human_context_profile"
          ]
        },
        "ref": {"$ref": "#/$defs/ref"},
        "role": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "recommended", "optional"]},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "provides": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "consumes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "fallback": {"$ref": "#/$defs/ref"}
      },
      "anyOf": [
        {"required": ["version"]},
        {"required": ["commit"]},
        {
          "properties": {
            "ref": {
              "type": "object",
              "anyOf": [
                {"required": ["version"]},
                {"required": ["commit"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "overrides": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
