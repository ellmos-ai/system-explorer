{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.ai/schemas/ellmos.stack-projection.v1.schema.json",
  "title": "ellmos deployment stack projection contract",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "purpose",
    "bundle_refs",
    "content_hash"
  ],
  "properties": {
    "schema": {"const": "ellmos.stack-projection.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "contract": {"$ref": "#/$defs/ref"},
    "bundle_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pinned_ref"}
    },
    "optional_bundle_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/ref"}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "identity": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["runtime_authority"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "runtime_authority": {"const": false}
      },
      "additionalProperties": true
    },
    "lifecycle": {"enum": ["draft", "active", "deprecated"]},
    "status": {"type": "string", "minLength": 1},
    "system_ref": {"type": "string", "minLength": 1},
    "access_surfaces": {"$ref": "#/$defs/string_array"},
    "decision_refs": {"$ref": "#/$defs/string_array"},
    "activation_gate": {"type": "string", "minLength": 1},
    "manifest_kind": {"const": "deployment-projection"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "ref": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "anyOf": [
            {"required": ["ref"]},
            {"required": ["id"]},
            {"required": ["path"]}
          ],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "minLength": 1},
            "content_hash": {"$ref": "#/$defs/hash"}
          },
          "additionalProperties": true
        }
      ]
    },
    "pinned_ref": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {
          "type": "object",
          "anyOf": [
            {"required": ["version"]},
            {"required": ["commit"]},
            {"required": ["content_hash"]}
          ]
        }
      ]
    }
  }
}
