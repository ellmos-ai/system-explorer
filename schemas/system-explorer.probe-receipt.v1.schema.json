{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ellmos-ai/system-explorer/schemas/system-explorer.probe-receipt.v1.schema.json",
  "title": "Referential external probe receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "receipt_id", "version", "source", "runner", "task", "experiment", "repetitions", "steps", "outcome", "metrics", "observed_at", "source_hash", "content_hash"],
  "properties": {
    "schema": {"const": "system-explorer.probe-receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["id", "uri", "sha256"], "properties": {"id": {"type": "string"}, "uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "runner": {"type": "object", "required": ["id"]},
    "task": {"type": "object", "required": ["id"]},
    "experiment": {"type": "object", "required": ["id"]},
    "repetitions": {"type": "integer", "minimum": 1},
    "steps": {"type": "array", "minItems": 1},
    "outcome": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["success", "failure", "uncertain"]}}},
    "metrics": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
