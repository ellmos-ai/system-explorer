{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ellmos.ai/schemas/ellmos.system-test.v1.schema.json",
  "title": "ellmos system test overlay contract",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "lifecycle",
    "authority",
    "provenance",
    "content_hash",
    "base_system_ref",
    "base_hash",
    "mode",
    "suppressions",
    "expected_functions",
    "expected_absent_functions",
    "tolerated_gaps",
    "writeback_to_base"
  ],
  "properties": {
    "schema": {"const": "ellmos.system-test.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "lifecycle": {"enum": ["draft", "active", "deprecated"]},
    "authority": {"type": "object"},
    "provenance": {"type": "object"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "base_system_ref": {"$ref": "#/$defs/pinned_ref"},
    "base_hash": {"$ref": "#/$defs/hash"},
    "mode": {"enum": ["resolution-only", "isolated-runtime"]},
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "reason"],
        "properties": {
          "ref": {"$ref": "#/$defs/ref"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "expected_functions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "expected_absent_functions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tolerated_gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "writeback_to_base": {"const": false}
  },
  "additionalProperties": true,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "registered",
        "available",
        "installed",
        "configured",
        "enabled",
        "active",
        "healthy",
        "suppressed",
        "experimental",
        "unavailable"
      ]
    },
    "ref": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "anyOf": [
            {"required": ["ref"]},
            {"required": ["id"]},
            {"required": ["path"]}
          ],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "minLength": 1},
            "content_hash": {"$ref": "#/$defs/hash"}
          },
          "additionalProperties": true
        }
      ]
    },
    "pinned_ref": {
      "allOf": [
        {"$ref": "#/$defs/ref"},
        {
          "type": "object",
          "anyOf": [
            {"required": ["version"]},
            {"required": ["commit"]},
            {"required": ["content_hash"]}
          ]
        }
      ]
    }
  }
}
