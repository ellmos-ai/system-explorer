{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ellmos-ai/system-explorer/schemas/ellmos.search-routing-query.v1.schema.json",
  "title": "ellmos Search Routing Query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "query_id",
    "query_mode",
    "scope",
    "required_capabilities",
    "exact_refs",
    "ranked_candidates",
    "authority_receipt_refs",
    "execution_requested",
    "observed_at",
    "content_hash"
  ],
  "properties": {
    "schema": {"const": "ellmos.search-routing-query.v1"},
    "query_id": {"type": "string", "minLength": 1},
    "query_mode": {"enum": ["skill-search", "tool-search", "tool-overview"]},
    "scope": {"type": "string", "minLength": 1},
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_ref"}
    },
    "ranked_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "score_domain", "candidates"],
        "properties": {
          "method": {
            "enum": ["semantic-ranker", "controlcenter-lexical-candidate"]
          },
          "score_domain": {"type": "string", "minLength": 1},
          "candidates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "score"],
              "properties": {
                "ref": {"$ref": "#/$defs/stable_ref"},
                "score": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "authority_receipt_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_ref"}
    },
    "execution_requested": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stable_ref": {
      "type": "string",
      "pattern": "^[^\\s:]+:[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
